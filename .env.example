# ---- Backend ----
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://merenda:merenda@localhost:5432/merenda?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# initial admin (created only if the admins table is empty)
ADMIN_EMAIL=admin@merenda.ru
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Владелец
# public urls (used for CORS, sitemap, OG links). Change here when the domain changes.
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_SITE_URL=http://localhost:5174
# media
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
# secure cookies (true in production behind https)
COOKIE_SECURE=false
