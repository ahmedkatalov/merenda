# ============================================================================
#  Merenda — production configuration
#  Copy to .env on the server and fill in the values, then:
#    docker compose up -d --build
#  Keep this file secret. It is git-ignored.
# ============================================================================

# ---- Domains --------------------------------------------------------------
# Your real domains, WITHOUT https:// and without a trailing slash.
# Point their DNS A-records at this server's public IP before starting.
MERENDA_SITE_DOMAIN=merenda-coffee.ru
MERENDA_ADMIN_DOMAIN=merenda-admin.ru

# ---- Security secrets -----------------------------------------------------
# Generate strong random values on the server:
#   JWT_SECRET:        openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 24
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ---- First admin account --------------------------------------------------
# Created automatically on first start (only while the admins table is empty).
# Change the password from inside the admin panel after the first login.
ADMIN_EMAIL=owner@merenda-coffee.ru
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_NAME=Владелец

# ---- Optional (sensible defaults if omitted) ------------------------------
POSTGRES_USER=merenda
POSTGRES_DB=merenda
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
MAX_UPLOAD_MB=10
